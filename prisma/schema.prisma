generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  recepcionista
  medico
  gerencia
}

enum EstadoCita {
  programada
  en_espera
  completada
  cancelada
}

model Users {
  id         Int      @id @default(autoincrement())
  nombre     String
  apellido   String
  email      String?  @unique
  contrasena String   @map("contraseña")
  telefono   String
  rol        Rol
  createAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  medico     Medico?

  @@map("Users")
}

model Pacientes {
  id                  Int      @id @default(autoincrement())
  nombre              String
  apellido            String
  fecha_de_nacimiento DateTime @db.Date
  email               String?
  createAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt

  citas               Cita[]

  @@map("Pacientes")
}

model Especialidad {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createAt    DateTime @default(now())

  medicos     Medico[]

  @@map("Especialidades")
}

model Medico {
  id              Int      @id @default(autoincrement())
  NumeroLicencia  String   @unique
  userId          Int      @unique
  EspecialidadId  Int
  createAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            Users        @relation(fields: [userId], references: [id], onDelete: Restrict)
  especialidad    Especialidad @relation(fields: [EspecialidadId], references: [id], onDelete: Restrict)
  citas           Cita[]

  @@map("medicos")
}

model Cita {
  id          Int        @id @default(autoincrement())
  fechaHora   DateTime
  Motivo      String
  estado      EstadoCita @default(programada)
  PacientesId Int
  medicoId    Int
  createAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  Paciente    Pacientes  @relation(fields: [PacientesId], references: [id], onDelete: Restrict)
  medico      Medico     @relation(fields: [medicoId], references: [id], onDelete: Restrict)

  @@index([PacientesId])
  @@index([medicoId, fechaHora])
  @@index([fechaHora, estado])
  @@map("citas")
}